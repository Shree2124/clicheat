# ──────────────────────────────────────────────────────────────
# LabX Remote – Environment Variables Reference
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────

# Base URL of the deployed site.
# Leave blank on Vercel — VERCEL_URL is injected automatically.
# Set this only if you use a custom domain.
BASE_URL=https://clicheat.vercel.app

# Optional: override the remote URL used by the LabX Python CLI.
# LABX_REMOTE_URL=https://clicheat.vercel.app
